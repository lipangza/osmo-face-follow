<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.facefollow.ui.OverlayView
        android:id="@+id/overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/switch_cam"
        android:layout_margin="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnM3Test"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/m3_test"
        android:textSize="11sp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnSwitch"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/followReadout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:textColor="#FF8C42"
        android:padding="6dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:text="@string/follow_readout_default"
        app:layout_constraintBottom_toTopOf="@id/swEyeLock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/swFollow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:saveEnabled="false"
        android:text="@string/follow_switch"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/followReadout"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/eyeReadout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:textColor="#FFD166"
        android:padding="6dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:text="闭眼检测：关闭"
        app:layout_constraintBottom_toTopOf="@id/bleLog"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/swEyeLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="@string/eye_lock_switch"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        app:layout_constraintBottom_toTopOf="@id/eyeReadout"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/bleLog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:textColor="#66CCFF"
        android:padding="8dp"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:maxLines="4"
        android:text="BLE 日志"
        app:layout_constraintBottom_toTopOf="@id/readout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/readout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#80000000"
        android:textColor="#33FF66"
        android:padding="10dp"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:text="初始化…"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
